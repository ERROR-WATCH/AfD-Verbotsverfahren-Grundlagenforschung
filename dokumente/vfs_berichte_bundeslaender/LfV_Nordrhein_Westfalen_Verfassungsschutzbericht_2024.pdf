   photoshop:City="Warsaw"
   photoshop:Country="POLAND"
   photoshop:Credit="picture alliance / ASSOCIATED PRESS"
   photoshop:Source="AP"
   photoshop:Instructions="This content is intended for editorial use only. For other uses, additional clearances may be required."
   photoshop:Category="New"
   photoshop:Headline="Poland Fire Vietnamese Traders"
   xmp:CreateDate="2024-05-15T10:06:22+00:00"
   xmpRights:Marked="True"
   Iptc4xmpCore:CountryCode="POL"
   xmpMM:InstanceID="uuid:8aa37c89-253f-11d6-8188-bc0c565c2f2f">
   <Iptc4xmpCore:CreatorContactInfo rdf:parseType="Resource"/>
   <dc:creator>
    <rdf:Seq>
     <rdf:li>Czarek Sokolowski</rdf:li>
    </rdf:Seq>
   </dc:creator>
   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Police walks by a temporary fence put up to block access to a burnt-down shopping center in Warsaw, Poland, on Wednesday, May 15, 2024. A weekend fire at the Marywilska 44 shopping center dealt tragedy to many members of Poland's Vietnamese community. People lost entire livelihoods and say they don't know how they will manage to make a living. (AP Photo/Czarek Sokolowski)</rdf:li>
    </rdf:Alt>
   </dc:description>
   <dc:rights>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">picture alliance / ASSOCIATED PRESS</rdf:li>
    </rdf:Alt>
   </dc:rights>
