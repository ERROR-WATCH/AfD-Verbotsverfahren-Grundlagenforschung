   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">More than 100,000 people are participating in the biggest demonstration against the Alternative for Germany party in Duesseldorf, Germany, on January 27, 2024. (Photo by Ying Tang/NurPhoto)</rdf:li>
