   <dc:creator>
    <rdf:Seq>
     <rdf:li>Mikhail Voskresensky</rdf:li>
    </rdf:Seq>
   </dc:creator>
   <dc:subject>
    <rdf:Bag>
     <rdf:li>Deal</rdf:li>
     <rdf:li>freed</rdf:li>
     <rdf:li>prisoner exchange</rdf:li>
     <rdf:li>prisoner swap</rdf:li>
     <rdf:li>released</rdf:li>
     <rdf:li>Politik</rdf:li>
    </rdf:Bag>
   </dc:subject>
   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">DIESES FOTO WIRD VON DER RUSSISCHEN STAATSAGENTUR TASS ZUR VERFÃœGUNG GESTELLT. [RUSSIA, MOSCOW - AUGUST 1, 2024: Russia's President Vladimir Putin (R) welcomes Russian citizens released in a prisoner exchange, at Vnukovo-2 Airport. The prisoner exchange between Russia and the West took place in Ankara on August 1; 26 prisoners who had been kept in prisons of the United States, Germany, Poland, Slovenia, Norway, Russia and Belarus, were released. Ten people including two minors, Artyom Dultsev, Anna Dultseva and their children, Vadim Krasikov, Pavel Rubtsov, Mikhail Mikushin, Roman Seleznev, Vladislav Klyushin, Vadim Konoshchenok, were sent to Russia, 13 to Germany and three to the United States. Mikhail Voskresensky/POOL/TASS]</rdf:li>
    </rdf:Alt>
   </dc:description>
   <dc:title>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">475564003</rdf:li>
    </rdf:Alt>
   </dc:title>
