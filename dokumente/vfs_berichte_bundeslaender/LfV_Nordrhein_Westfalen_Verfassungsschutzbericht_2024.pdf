   photoshop:City="Duesseldorf"
   photoshop:Country="Deutschland"
   photoshop:Credit="picture alliance / NurPhoto"
   photoshop:Source="NurPhoto"
   photoshop:Category="SOI"
   photoshop:Headline="AFD Protest Against Housing For Migrants In Duesseldorf And Counter Protest"
   xmp:CreateDate="2024-03-16T00:00:00+00:00"
   xmpRights:Marked="True"
   Iptc4xmpCore:CountryCode="DEU"
   xmpMM:InstanceID="uuid:8aa37c89-253f-11d6-8188-bc0c565c2f2f">
   <Iptc4xmpCore:CreatorContactInfo rdf:parseType="Resource"/>
   <dc:creator>
    <rdf:Seq>
     <rdf:li>Ying Tang</rdf:li>
    </rdf:Seq>
   </dc:creator>
   <dc:subject>
    <rdf:Bag>
     <rdf:li>DEUTSCHLAND</rdf:li>
     <rdf:li>Einwanderung</rdf:li>
     <rdf:li>FlÃ¼chtlinge</rdf:li>
     <rdf:li>Immigration</rdf:li>
     <rdf:li>Integration</rdf:li>
     <rdf:li>Protest</rdf:li>
     <rdf:li>Soziales</rdf:li>
     <rdf:li>Unterbringung</rdf:li>
     <rdf:li>Vertriebene</rdf:li>
     <rdf:li>yingphotography</rdf:li>
     <rdf:li>ying tang</rdf:li>
     <rdf:li>Unterkunft</rdf:li>
    </rdf:Bag>
   </dc:subject>
   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Thousands of counter-protesters are gathering at Zoo Square in Duesseldorf, Germany, on March 16, 2024, as the Duesseldorf government plans to add additional refugee housing in the area. (Photo by Ying Tang/NurPhoto)</rdf:li>
    </rdf:Alt>
   </dc:description>
